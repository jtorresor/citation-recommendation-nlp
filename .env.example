# Copia este archivo como .env . NO lo subas al repositorio.
# En la EC2 el pipeline de GitHub Actions lo genera solo a partir de los secrets.

# --- Imagen -----------------------------------------------------------------
# En la EC2 la escribe el pipeline: ghcr.io/<owner>/<repo>/mlflow-server:<sha>
MLFLOW_IMAGE=mlflow-server:latest
MLFLOW_VERSION=3.16.0

# --- Red --------------------------------------------------------------------
# IP elastica o DNS publico de la EC2 (sin http:// y sin puerto).
# En local usa 127.0.0.1
MLFLOW_PUBLIC_HOST=127.0.0.1
MLFLOW_HOST_PORT=8080
MLFLOW_WORKERS=2

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=mlflow

# --- Autenticacion basica (recomendada si el puerto queda abierto a internet)
MLFLOW_AUTH_ENABLED=false
MLFLOW_AUTH_USERNAME=admin
MLFLOW_AUTH_PASSWORD=
